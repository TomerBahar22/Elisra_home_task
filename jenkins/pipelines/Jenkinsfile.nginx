pipeline {
    agent { label 'docker' }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        TRIVY_IMAGE = 'aquasec/trivy:latest'
        IMAGE       = 'tomerbahar2/nginx-proxy'
        APP_DIR     = 'jenkins/nginx-proxy'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Release') {
            when {
                anyOf {
                    changeset 'jenkins/nginx-proxy/**'
                    triggeredBy 'UserIdCause'
                }
            }
            stages {
                stage('Read version') {
                    steps {
                        script {
                            env.VERSION = readFile("${APP_DIR}/VERSION").trim()
                            currentBuild.displayName = "#${env.BUILD_NUMBER} v${env.VERSION}"
                        }
                        sh '''
                            echo "$VERSION" | grep -Eq '^[0-9]+[.][0-9]+[.][0-9]+$' \
                                || { echo "VERSION must look like 1.2.3, got: $VERSION"; exit 1; }

                            if docker manifest inspect $IMAGE:$VERSION > /dev/null 2>&1; then
                                echo "$IMAGE:$VERSION already exists. Bump $APP_DIR/VERSION."
                                exit 1
                            fi
                        '''
                    }
                }

                stage('Build image') {
                    steps {
                        dir("${APP_DIR}") {
                            sh 'docker build -t $IMAGE:$VERSION -t $IMAGE:latest .'
                        }
                    }
                }

                stage('Config test') {
                    steps {
                        // Nginx resolves "flask-app" at startup; fake it so the check can run
                        sh 'docker run --rm --add-host flask-app:127.0.0.1 $IMAGE:$VERSION nginx -t'
                    }
                }

                stage('Security scan') {
                    steps {
                        sh '''
                            docker save $IMAGE:$VERSION -o image.tar
                            docker run --rm \
                                -v "$PWD/image.tar:/image.tar:ro" \
                                -v trivy-cache:/root/.cache/ \
                                $TRIVY_IMAGE image --input /image.tar \
                                --severity CRITICAL --ignore-unfixed --exit-code 1 --no-progress
                        '''
                    }
                }

                stage('Push to Docker Hub') {
                    steps {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                          usernameVariable: 'DH_USER',
                                                          passwordVariable: 'DH_TOKEN')]) {
                            sh '''
                                echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                                docker push $IMAGE:$VERSION
                                docker push $IMAGE:latest
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        cleanup {
            sh 'docker image rm $IMAGE:$VERSION $IMAGE:latest || true'
            deleteDir()
        }
    }
}